# Cloudflare Web Analytics — คัดลอก token จาก Cloudflare dashboard
#   Cloudflare → Analytics & Logs → Web Analytics → เลือกไซต์ → JS snippet → ค่า "token"
#
# ไม่ตั้งค่า = ไม่มี script วิเคราะห์ใด ๆ ออกไปที่หน้าเว็บเลย (ไม่ใช่ script เปล่าที่ยิง request ทิ้ง)
# ตัวแปรขึ้นต้นด้วย PUBLIC_ เพราะ token นี้ตั้งใจให้เปิดเผยได้ในฝั่ง client อยู่แล้ว
#
# ⚠️ ตอนนี้ห้ามตั้งค่าตัวแปรนี้ ไม่ว่าจะที่นี่หรือเป็น repository variable
#
# production ของ toolsiam.com เปิด Web Analytics แบบ Automatic setup อยู่แล้วตั้งแต่ 7 ก.ย. 2569
# (โหมด "Enable, excluding visitor data in the EU") คือ Cloudflare ฉีด beacon ให้เองที่ขอบเครือข่าย
# ถ้าตั้ง token ทับจะได้ beacon สองตัวในหน้าเดียว → pageview นับซ้ำสองเท่า
#
# จะใช้ตัวแปรนี้ได้ต่อเมื่อไปสลับ dash → Analytics → Web analytics → toolsiam.com → Manage site
# เป็น "Enable with JS Snippet installation" ก่อนเท่านั้น — เปิดสองทางพร้อมกันไม่ได้
PUBLIC_CF_BEACON_TOKEN=

# ---------------------------------------------------------------------------
# ระบบสมาชิก + พรีเมียม (spec docs/superpowers/specs/2026-09-19-membership-premium-design.md)
#
# ค่า build-time (ตั้งเป็น repository variable ใน GitHub Actions หรือ .env ตอน build):
#   PUBLIC_MEMBERSHIP=on   → header/หน้า /premium แสดงปุ่มเข้าสู่ระบบ · ไม่ตั้ง = HTML เหมือนไม่มีระบบสมาชิก
PUBLIC_MEMBERSHIP=

# ค่า runtime ของ Worker อยู่ใน wrangler.jsonc (vars) และ secret ตั้งด้วย `wrangler secret put <ชื่อ>`
# ตอน dev ใส่ทั้งหมดใน .dev.vars (gitignore แล้ว) ให้ wrangler/astro dev อ่าน:
#   MEMBERSHIP=on                    kill switch ฝั่ง server — ต้องเป็น on ทุก API ถึงจะทำงาน (ไม่งั้นตอบ 204)
#   SITE_ORIGIN=http://localhost:4321  origin ที่ใช้สร้าง redirect URI ของ Google และตรวจ Origin
#   GOOGLE_CLIENT_ID=                (var) Web client จาก Google Cloud Console
#   GOOGLE_CLIENT_SECRET=            (secret)
#   BEAM_API_BASE_URL=https://playground.api.beamcheckout.com   (var) สลับเป็น https://api.beamcheckout.com ตอน production
#   BEAM_MERCHANT_ID=                (var)
#   BEAM_API_KEY=                    (secret)
#   BEAM_WEBHOOK_HMAC_SECRET=        (secret, base64)
