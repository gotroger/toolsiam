{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "@cloudflare/workers-types",
      "vitest/globals"
    ],
    "noEmit": true
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "workers/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
