---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { COVER_HEIGHT, COVER_WIDTH, DEFAULT_OG_IMAGE } from '@/tools/covers';
import { isNoindexPath, normalizePath } from '@/lib/noindex';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** override path ที่ใช้คำนวณ canonical (ปกติไม่ต้องระบุ — ใช้ pathname ของหน้าเอง) */
  canonicalPath?: string;
  /** true = ใช้ความกว้างเต็มคอนเทนเนอร์ 1320px (หน้ากริดการ์ด) / false = จำกัดความกว้างเพื่อให้อ่านง่าย */
  wide?: boolean;
  /** ภาพ og:image (path จาก root) ถ้าไม่ระบุจะใช้ภาพเริ่มต้นของเว็บ */
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title, description, jsonLd = [], noindex = false, wide = false, canonicalPath,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = 'ทูลสยาม ToolSiam — เครื่องมือออนไลน์ภาษาไทย ใช้ฟรี',
} = Astro.props;
// normalizePath ตัด .html / trailing slash ให้ทุกหน้า รวม nested route เช่น /lottery/results/2026-09-01
const canonicalPathname = canonicalPath ?? normalizePath(Astro.url.pathname);
const canonical = new URL(canonicalPathname, Astro.site);
// noindex มาจากรายการกลางเสมอ prop เป็นแค่ตัวเสริม → sitemap กับ meta ไม่มีทางไม่ตรงกัน
const isNoindex = noindex || isNoindexPath(canonicalPathname);
// crawler ส่วนใหญ่ต้องการ URL เต็ม ไม่ใช่ path
const ogImageUrl = new URL(ogImage, Astro.site);
const ogImageType = ogImage.endsWith('.png') ? 'image/png' : ogImage.endsWith('.webp') ? 'image/webp' : 'image/jpeg';

/**
 * Cloudflare Web Analytics (§Phase 5)
 *
 * เลือก Cloudflare Web Analytics เพราะไม่ใช้คุกกี้ ไม่เก็บข้อมูลระบุตัวบุคคล และไม่ต้องมีแบนเนอร์ขอความยินยอม
 * ซึ่งตรงกับคำสัญญาบนหน้าเว็บว่าข้อมูลที่ผู้ใช้กรอกไม่ถูกส่งออกไปที่ไหน
 *
 * token มาจาก env `PUBLIC_CF_BEACON_TOKEN` ไม่ได้ฝังไว้ในซอร์ส — ถ้ายังไม่ตั้งค่า
 * จะไม่มี script ใด ๆ ออกไปที่หน้าเว็บเลย (ไม่ใช่ script เปล่าที่ยิง request ทิ้ง)
 *
 * ⚠️ production ไม่ได้เดินทางนี้ — toolsiam.com เปิด Web Analytics แบบ Automatic setup
 * (โหมด "Enable, excluding visitor data in the EU") ตั้งแต่ 7 ก.ย. 2569 คือ Cloudflare
 * ฉีด beacon ให้เองที่ขอบเครือข่าย เว็บจึงมี analytics อยู่แล้วโดยที่ token ว่าง
 * ดูได้ที่ dash → Analytics → Web analytics → toolsiam.com → Manage site
 *
 * จึง **ห้ามตั้ง `PUBLIC_CF_BEACON_TOKEN`** ไม่ว่าจะเป็น repository variable หรือ .env
 * เพราะจะได้ beacon สองตัวในหน้าเดียว → pageview นับซ้ำสองเท่า
 * ถ้าวันหลังอยากมาใช้ทางนี้จริง ต้องไปสลับเป็น "Enable with JS Snippet installation" ก่อน
 * แล้วค่อยตั้ง token — สลับสองอย่างนี้พร้อมกันไม่ได้
 */
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <!--
      ตั้งธีมก่อนเบราว์เซอร์วาดครั้งแรก — is:inline + อยู่บนสุดของ <head> โดยตั้งใจ
      ถ้าปล่อยให้สคริปต์นี้โหลดทีหลัง ผู้ใช้ที่เลือกโหมดมืดไว้จะเห็นหน้าขาววาบก่อนหนึ่งเฟรม

      ไม่ตั้งอะไรเลยเมื่อผู้ใช้ยังไม่เคยเลือก — ปล่อยให้ prefers-color-scheme ทำงานตามระบบ
    -->
    <script is:inline>
      try {
        const t = localStorage.getItem('toolsiam-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch { /* โหมดส่วนตัวบางเบราว์เซอร์โยนตอนอ่าน localStorage */ }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isNoindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="ทูลสยาม ToolSiam" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(COVER_WIDTH)} />
    <meta property="og:image:height" content={String(COVER_HEIGHT)} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/*
      ฟอนต์โฮสต์เองใน public/fonts (ดู @font-face ใน global.css) จึงไม่มี preconnect
      ไปโดเมนภายนอกอีกแล้ว — preload เฉพาะสองหน้าตัวที่ทุกหน้าใช้แน่ ๆ ตั้งแต่เฟรมแรก
      คือเนื้อความไทยกับหัวข้อไทย ที่เหลือปล่อยให้ unicode-range เรียกเองเมื่อจำเป็น
    */}
    <link rel="preload" href="/fonts/sarabun-400-thai.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/prompt-500-thai.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 font-sans text-slate-900 antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-[60] focus:rounded-lg focus:bg-action focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white">ข้ามไปยังเนื้อหาหลัก</a>
    <Header />
    <main id="main" class="site-container flex-1 py-8 sm:py-10">
      {wide ? <slot /> : <div class="mx-auto w-full max-w-4xl"><slot /></div>}
    </main>
    <Footer />
    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: beaconToken })}
      />
    )}
  </body>
</html>
