---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import Section from '@/components/Section.astro';
import VerticalShell from '@/components/VerticalShell.astro';
import LuckyColorFinder from '@/components/horoscope/LuckyColorFinder';
import { getHomeUrl, getHoroscopePageUrl, getHoroscopeUrl } from '@/lib/routes';
import { THAI_DAY_COLORS, THAI_WEEKDAYS } from '@/lib/thai-date';

const title = 'สีมงคลประจำวันเกิด — สีเสริมการงาน การเงิน ความรัก';
const description = 'ดูสีมงคลประจำวันเกิดตามคติไทย ทั้งสีเสริมการงาน การเงิน ความรัก โชคลาภ และสีที่ความเชื่อว่าควรเลี่ยง พร้อมตารางสีประจำวันครบทั้งเจ็ดวัน';
---
<Base title={`${title} — ทูลสยาม`} description={description}>
  <VerticalShell
    title="สีมงคลประจำวันเกิด"
    description="กรอกวันเกิดแล้วดูสีเสริมการงาน การเงิน ความรัก โชคลาภ และสีที่ควรเลี่ยงตามคติไทย"
    category="horoscope"
    gradient={['#fff7ed', '#fed7aa']}
    crumbs={[
      { name: 'ทูลสยาม', path: getHomeUrl() },
      { name: 'ดูดวงและความเชื่อ', path: getHoroscopeUrl() },
      { name: 'สีมงคลประจำวันเกิด', path: getHoroscopePageUrl('lucky-color') },
    ]}
  >
    <Card>
      <LuckyColorFinder client:load />
    </Card>

    <Section title="สีประจำวันตามคติไทย" class="mt-8">
      <p class="mt-1 text-sm text-slate-600">
        คติไทยกำหนดสีประจำวันไว้ตามเทพประจำวันในตำนาน ซึ่งเป็นที่มาของธรรมเนียมแต่งกายตามสีวันด้วย
      </p>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
        {THAI_WEEKDAYS.map((day, i) => (
          <Card as="li" size="sm">
            <span class="font-medium text-slate-900">วัน{day}</span>{' '}
            <span class="text-slate-600">สี{THAI_DAY_COLORS[i]}</span>
          </Card>
        ))}
      </ul>
    </Section>

    <Section title="คำถามที่พบบ่อย" class="mt-8 space-y-4">
      <div>
        <h3 class="font-medium text-slate-900">สีมงคลของแต่ละตำราตรงกันไหม</h3>
        <p class="text-sm text-slate-600">
          ไม่ตรงกันทั้งหมด ตำราสีมงคลมีหลายสำนักและแต่ละสำนักจัดสีตามหลักที่ต่างกัน
          ชุดที่ใช้ในหน้านี้ยึดแนวที่เผยแพร่กันทั่วไป ถ้าเจอข้อมูลที่ต่างจากนี้ไม่ได้แปลว่าฝ่ายใดผิด
        </p>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">ใช้สีตามวันเกิดหรือวันที่ใส่</h3>
        <p class="text-sm text-slate-600">
          ความเชื่อมีทั้งสองแบบ หน้านี้คำนวณจากวันเกิดซึ่งเป็นสีประจำตัวที่ไม่เปลี่ยน
          ส่วนธรรมเนียมแต่งกายตามสีของวันในสัปดาห์เป็นคนละเรื่อง ใช้ตารางสีประจำวันด้านบนได้เลย
        </p>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">ต้องเลี่ยงสีกาลกิณีจริงจังแค่ไหน</h3>
        <p class="text-sm text-slate-600">
          เป็นความเชื่อส่วนบุคคล ไม่มีผลบังคับใด ๆ หลายคนใช้เป็นแนวทางเลือกเสื้อผ้าในวันสำคัญเพื่อความสบายใจ
          ซึ่งก็เป็นประโยชน์ในตัวมันเองโดยไม่ต้องเชื่อว่ามีผลจริง
        </p>
      </div>
    </Section>
  </VerticalShell>
</Base>
