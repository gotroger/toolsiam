---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import VerticalShell from '@/components/VerticalShell.astro';
import { collectionPageJsonLd } from '@/lib/seo';
import { getDreamUrl, getHomeUrl, getHoroscopePageUrl, getHoroscopeUrl } from '@/lib/routes';
import { HOROSCOPE_PAGES as pages } from '@/lib/horoscope-pages';
import ZodiacBadge from '@/components/horoscope/ZodiacBadge';
import { ZODIAC_SIGNS, zodiacRange } from '@/lib/thai-astro';

const title = 'ดูดวงและความเชื่อ — ราศี ปีนักษัตร สีมงคล และดวงรายวัน';
const description =
  'รวมเครื่องมือดูดวงตามความเชื่อไทยและสากล ทั้งราศีจากวันเกิด ปีนักษัตรที่ตัดปีด้วยตรุษจีน สีมงคลประจำวัน เลขศาสตร์วันเกิด และดวงรายวัน 12 ราศีที่เปลี่ยนทุกเที่ยงคืนตามเวลาไทย';
---

<Base
  title={`${title} — ทูลสยาม`}
  description={description}
  wide
  jsonLd={[
    collectionPageJsonLd({
      name: title,
      description,
      path: getHoroscopeUrl(),
      items: pages.map((p) => ({ name: p.name, path: p.path })),
    }),
  ]}
>
  <VerticalShell
    title="ดูดวงและความเชื่อ"
    description={description}
    category="horoscope"
    gradient={['#fdf2f8', '#fbcfe8']}
    crumbs={[
      { name: 'ทูลสยาม', path: getHomeUrl() },
      { name: 'ดูดวงและความเชื่อ', path: getHoroscopeUrl() },
    ]}
  >
    <div class="horoscope-hub" data-category="horoscope">
      {
        pages.map((p) => (
          <a href={p.path} class:list={['horoscope-tile', p.featured && 'horoscope-tile-featured']}>
            <span class="tool-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={p.icon} />
              </svg>
            </span>
            <span class="horoscope-tile-copy">
              <h2>{p.name}</h2>
              <p>{p.desc}</p>
            </span>
            <span class="tile-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </div>

    <Section title="ดูดวงวันนี้ตามราศี" class="mt-10">
      <p class="mt-1 text-sm text-slate-600">
        แตะราศีเพื่อเปิดดวงประจำวัน · ใช้ราศีสากล (Western/Tropical) ระบบเดียวกับสื่อดูดวงทั่วไป
      </p>
      <ul class="zodiac-picker mt-4">
        {
          ZODIAC_SIGNS.map((s) => (
            <li>
              <a class="zodiac-option" data-element={s.element} href={`${getHoroscopePageUrl('daily')}?sign=${s.id}`}>
                <ZodiacBadge sign={s} />
                <span class="zodiac-option-name">{s.name}</span>
                <span class="zodiac-option-range">{zodiacRange(s)}</span>
                <span class="zodiac-option-range">ธาตุ{s.element}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </Section>

    <p class="mt-8 text-sm text-slate-600">
      สนใจเรื่องความฝัน ดูความหมายตามตำราไทยได้ที่{' '}
      <a href={getDreamUrl()} class="text-brand-700 underline underline-offset-2 hover:text-brand-800">หน้าทำนายฝัน</a>
    </p>
  </VerticalShell>
</Base>
