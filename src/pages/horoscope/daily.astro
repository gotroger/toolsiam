---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import Section from '@/components/Section.astro';
import VerticalShell from '@/components/VerticalShell.astro';
import DailyHoroscope from '@/components/horoscope/DailyHoroscope';
import { getHomeUrl, getHoroscopePageUrl, getHoroscopeUrl } from '@/lib/routes';
import ZodiacBadge from '@/components/horoscope/ZodiacBadge';
import { ZODIAC_SIGNS, zodiacRange } from '@/lib/thai-astro';

const title = 'ดวงรายวัน 12 ราศี — ความรัก การเงิน การงาน สุขภาพ';
const description =
  'ดูดวงรายวันครบทั้ง 12 ราศี แยกเป็นความรัก การเงิน การงาน และสุขภาพ เปลี่ยนทุกเที่ยงคืนตามเวลาประเทศไทย ผู้ใช้ทุกประเทศจึงเห็นดวงของวันเดียวกัน';
---

<Base title={`${title} — ทูลสยาม`} description={description}>
  <VerticalShell
    title="ดวงรายวัน 12 ราศี"
    description="เลือกราศีแล้วดูดวงประจำวันแยกเป็นความรัก การเงิน การงาน และสุขภาพ เปลี่ยนทุกเที่ยงคืนตามเวลาไทย"
    category="horoscope"
    gradient={['#eff6ff', '#bfdbfe']}
    crumbs={[
      { name: 'ทูลสยาม', path: getHomeUrl() },
      { name: 'ดูดวงและความเชื่อ', path: getHoroscopeUrl() },
      { name: 'ดวงรายวัน 12 ราศี', path: getHoroscopePageUrl('daily') },
    ]}
  >
    <Card>
      <DailyHoroscope client:load />
    </Card>

    <!--
      เนื้อหาที่ crawler เห็นตอน build ต้องเป็นส่วน evergreen เท่านั้น (§9.5 ⚠️ SEO)
      ตัวดวงรายวันด้านบนเป็น enhancement ฝั่ง client ไม่ใช่เนื้อหาที่ใช้จัดอันดับ
    -->
    <Section title="ดวงรายวันของทูลสยามทำงานอย่างไร" class="mt-8">
      <div class="mt-2 space-y-3 text-sm text-slate-600">
        <p>
          ข้อความดวงรายวันมาจากคลังข้อความที่เขียนไว้ล่วงหน้า และเลือกด้วยสูตรที่คงที่จากราศีกับวันที่ ไม่ใช่การสุ่ม
          เปิดกี่ครั้งในวันเดียวกันก็ได้ข้อความเดิมเสมอ และไม่มีการเรียกปัญญาประดิษฐ์มาแต่งข้อความใหม่
        </p>
        <p>
          วันที่ที่ใช้คือวันตามเวลาประเทศไทยเสมอ คนไทยที่อยู่ต่างประเทศจึงเห็นดวงของวันเดียวกับคนที่อยู่ในไทย
          ไม่ใช่ดวงของวันตามเขตเวลาที่เครื่องตัวเองอยู่
        </p>
        <p>ในวันเดียวกัน ทั้ง 12 ราศีจะได้ข้อความคนละข้อความ ไม่มีสองราศีใดได้ข้อความซ้ำกัน</p>
      </div>
    </Section>

    <Section title="ราศีทั้ง 12 และลักษณะประจำราศี" class="mt-8">
      <ul class="zodiac-cards mt-4">
        {
          ZODIAC_SIGNS.map((s) => (
            <li class="zodiac-card" data-element={s.element}>
              <ZodiacBadge sign={s} />
              <div>
                <h3>
                  {s.name}{' '}
                  <span>
                    {zodiacRange(s)} · ธาตุ{s.element}
                  </span>
                </h3>
                <p>{s.summary}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </Section>
  </VerticalShell>
</Base>
