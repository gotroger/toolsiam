---
import Base from '@/layouts/Base.astro';
import VerticalShell from '@/components/VerticalShell.astro';
import DailyHoroscope from '@/components/horoscope/DailyHoroscope';
import { getHomeUrl, getHoroscopePageUrl, getHoroscopeUrl } from '@/lib/routes';
import { ZODIAC_SIGNS } from '@/lib/thai-astro';
import { DAILY_CATEGORIES } from '@/content/horoscope/daily-pool';

const title = 'ดวงรายวัน 12 ราศี — ความรัก การเงิน การงาน สุขภาพ';
const description = 'ดูดวงรายวันครบทั้ง 12 ราศี แยกเป็นความรัก การเงิน การงาน และสุขภาพ เปลี่ยนทุกเที่ยงคืนตามเวลาประเทศไทย ผู้ใช้ทุกประเทศจึงเห็นดวงของวันเดียวกัน';
---
<Base title={`${title} — ทูลสยาม`} description={description}>
  <VerticalShell
    title="ดวงรายวัน 12 ราศี"
    description="เลือกราศีแล้วดูดวงประจำวันแยกเป็นความรัก การเงิน การงาน และสุขภาพ เปลี่ยนทุกเที่ยงคืนตามเวลาไทย"
    icon="🌤️"
    gradient={['#eff6ff', '#bfdbfe']}
    crumbs={[
      { name: 'ทูลสยาม', path: getHomeUrl() },
      { name: 'ดูดวงและความเชื่อ', path: getHoroscopeUrl() },
      { name: 'ดวงรายวัน 12 ราศี', path: getHoroscopePageUrl('daily') },
    ]}
  >
    <section class="rounded-xl border border-slate-200 bg-white p-4 sm:p-6">
      <DailyHoroscope client:load />
    </section>

    <!--
      เนื้อหาที่ crawler เห็นตอน build ต้องเป็นส่วน evergreen เท่านั้น (§9.5 ⚠️ SEO)
      ตัวดวงรายวันด้านบนเป็น enhancement ฝั่ง client ไม่ใช่เนื้อหาที่ใช้จัดอันดับ
    -->
    <section class="mt-8">
      <h2 class="text-lg font-bold tracking-tight text-slate-900">ดวงรายวันของทูลสยามทำงานอย่างไร</h2>
      <div class="mt-2 space-y-3 text-sm text-slate-600">
        <p>
          ข้อความดวงรายวันมาจากคลังข้อความที่เขียนไว้ล่วงหน้า และเลือกด้วยสูตรที่คงที่จากราศีกับวันที่
          ไม่ใช่การสุ่ม เปิดกี่ครั้งในวันเดียวกันก็ได้ข้อความเดิมเสมอ และไม่มีการเรียกปัญญาประดิษฐ์มาแต่งข้อความใหม่
        </p>
        <p>
          วันที่ที่ใช้คือวันตามเวลาประเทศไทยเสมอ คนไทยที่อยู่ต่างประเทศจึงเห็นดวงของวันเดียวกับคนที่อยู่ในไทย
          ไม่ใช่ดวงของวันตามเขตเวลาที่เครื่องตัวเองอยู่
        </p>
        <p>
          ในวันเดียวกัน ทั้ง 12 ราศีจะได้ข้อความคนละข้อความ ไม่มีสองราศีใดได้ข้อความซ้ำกัน
        </p>
      </div>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-bold tracking-tight text-slate-900">แบ่งเป็นสี่ด้าน</h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {DAILY_CATEGORIES.map((c) => (
          <li class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700">
            <span aria-hidden="true">{c.icon}</span> {c.label}
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-8">
      <h2 class="text-lg font-bold tracking-tight text-slate-900">ราศีทั้ง 12 และลักษณะประจำราศี</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {ZODIAC_SIGNS.map((s) => (
          <li class="rounded-[10px] border border-slate-200 bg-white p-4">
            <h3 class="font-semibold text-slate-900">
              <span aria-hidden="true">{s.symbol}</span> {s.name} · ธาตุ{s.element}
            </h3>
            <p class="mt-1 text-sm text-slate-600">{s.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </VerticalShell>
</Base>
