---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import Section from '@/components/Section.astro';
import VerticalShell from '@/components/VerticalShell.astro';
import ChineseZodiacFinder from '@/components/horoscope/ChineseZodiacFinder';
import { getHomeUrl, getHoroscopePageUrl, getHoroscopeUrl } from '@/lib/routes';
import { CHINESE_ZODIAC } from '@/lib/thai-astro';

const title = 'ปีนักษัตรจากปีเกิด — ตัดปีด้วยตรุษจีนอย่างถูกต้อง';
const description = 'หาปีนักษัตรจากวันเกิดโดยใช้วันตรุษจีนเป็นเกณฑ์เปลี่ยนปี คนที่เกิดเดือนมกราคมถึงต้นกุมภาพันธ์จึงได้นักษัตรที่ถูกต้อง พร้อมลักษณะประจำนักษัตรครบทั้ง 12 ปี';
---
<Base title={`${title} — ทูลสยาม`} description={description}>
  <VerticalShell
    title="ปีนักษัตรจากปีเกิด"
    description="ใช้วันตรุษจีนเป็นเกณฑ์ตัดปี คนที่เกิดต้นปีจึงได้นักษัตรที่ถูกต้อง ไม่ใช่นักษัตรของปีปฏิทิน"
    category="horoscope"
    gradient={['#fef2f2', '#fecaca']}
    crumbs={[
      { name: 'ทูลสยาม', path: getHomeUrl() },
      { name: 'ดูดวงและความเชื่อ', path: getHoroscopeUrl() },
      { name: 'ปีนักษัตรจากปีเกิด', path: getHoroscopePageUrl('chinese-zodiac') },
    ]}
  >
    <Card>
      <ChineseZodiacFinder client:load />
    </Card>

    <Section title="นักษัตรทั้ง 12 ปี" class="mt-8">
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {CHINESE_ZODIAC.map((a) => (
          <Card as="li" size="md">
            <h3 class="font-medium text-slate-900">
              ปี{a.name}
            </h3>
            <p class="mt-1 text-sm text-slate-600">{a.summary}</p>
            <p class="mt-2 text-xs text-slate-500">{a.traits.join(' · ')}</p>
          </Card>
        ))}
      </ul>
    </Section>

    <Section title="คำถามที่พบบ่อย" class="mt-8 space-y-4">
      <div>
        <h3 class="font-medium text-slate-900">ทำไมเกิดเดือนมกราคมแล้วได้นักษัตรของปีก่อน</h3>
        <p class="text-sm text-slate-600">
          เพราะปฏิทินจีนเปลี่ยนปีนักษัตรที่วันตรุษจีน ซึ่งตกอยู่ระหว่างปลายเดือนมกราคมถึงกลางเดือนกุมภาพันธ์
          ไม่ใช่วันที่ 1 มกราคม คนที่เกิดก่อนตรุษจีนของปีตัวเองจึงยังนับเป็นนักษัตรของปีก่อนหน้า
          เครื่องมือนี้แสดงวันตรุษจีนของปีเกิดให้เห็นด้วย เพื่อให้ตรวจสอบตามได้
        </p>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">การนับแบบสงกรานต์ต่างจากนี้อย่างไร</h3>
        <p class="text-sm text-slate-600">
          โหราศาสตร์ไทยบางสำนักนับปีนักษัตรเปลี่ยนที่วันสงกรานต์ในเดือนเมษายน ซึ่งจะให้ผลต่างจากการนับแบบตรุษจีน
          สำหรับคนที่เกิดระหว่างตรุษจีนถึงสงกรานต์ ทูลสยามเลือกใช้เกณฑ์ตรุษจีนเพราะเป็นเกณฑ์ที่ใช้กันแพร่หลายที่สุด
          และตรงกับที่ระบุในปฏิทินจีนสากล
        </p>
      </div>
      <div>
        <h3 class="font-medium text-slate-900">รองรับปีเกิดถึงเมื่อไหร่</h3>
        <p class="text-sm text-slate-600">
          รองรับปีเกิด ค.ศ. 1940–2040 เพราะต้องอาศัยตารางวันตรุษจีนรายปี ไม่ใช่สูตรคำนวณ
          หากอยู่นอกช่วงนี้เครื่องมือจะแจ้งให้ทราบแทนการเดาผลลัพธ์
        </p>
      </div>
    </Section>
  </VerticalShell>
</Base>
