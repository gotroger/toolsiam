---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import Section from '@/components/Section.astro';
import DataTable from '@/components/DataTable.astro';
import DesignSystemDemo from '@/components/DesignSystemDemo';
import { getDesignSystemUrl } from '@/lib/routes';

/**
 * หน้ารวม primitive ทั้งหมดในที่เดียว (noindex, ไม่มีลิงก์จากเมนู)
 *
 * มีไว้เพื่อสองอย่าง:
 *   1. ดู primitive ทุกตัวพร้อมกันเวลาแก้ token — ไม่ต้องไล่เปิดหน้าเครื่องมือทีละหน้า
 *   2. เป็นที่ตรวจ dark mode และคู่สีในรอบเดียว
 *
 * ถูกกว่า Storybook มากสำหรับโปรเจกต์ขนาดนี้ และไม่ต้องดูแล build อีกชุด
 */
const RADII = [
  { name: 'rounded-lg', use: 'ชิป ปุ่มเล็ก แท็บ' },
  { name: 'rounded-[10px]', use: 'ช่องกรอก ปุ่ม การ์ดในกริด ตาราง' },
  { name: 'rounded-xl', use: 'การ์ดหลัก' },
  { name: 'rounded-2xl', use: 'แบนเนอร์ หัวเรื่อง vertical' },
];
/**
 * เขียนคลาสเต็มทีละตัว ไม่ประกอบด้วย `bg-brand-${n}`
 * Tailwind สแกนหาคลาสจากซอร์สแบบตรงตัว คลาสที่ประกอบตอนรันจะไม่ถูกสร้าง CSS ให้
 */
const BRAND = [
  { name: 'brand-50', cls: 'bg-brand-50' },
  { name: 'brand-100', cls: 'bg-brand-100' },
  { name: 'brand-200', cls: 'bg-brand-200' },
  { name: 'brand-300', cls: 'bg-brand-300' },
  { name: 'brand-400', cls: 'bg-brand-400' },
  { name: 'brand-500', cls: 'bg-brand-500' },
  { name: 'brand-600', cls: 'bg-brand-600' },
  { name: 'brand-700', cls: 'bg-brand-700' },
  { name: 'brand-800', cls: 'bg-brand-800' },
  { name: 'brand-900', cls: 'bg-brand-900' },
];
---
<Base
  title="Design system — ทูลสยาม"
  description="หน้ารวม primitive ของทูลสยามสำหรับคนทำเว็บ"
  canonicalPath={getDesignSystemUrl()}
  noindex
  wide
>
  <h1 class="text-2xl font-medium tracking-tight text-slate-900 sm:text-[1.75rem]">Design system</h1>
  <p class="mt-2 max-w-3xl text-slate-600">
    รวม primitive ทุกตัวไว้ที่เดียวเพื่อดูผลของ token พร้อมกัน หน้านี้ไม่เข้า sitemap
    และไม่มีลิงก์จากเมนู — เข้าถึงด้วยการพิมพ์ URL เท่านั้น
  </p>

  <Section title="สีแบรนด์" class="mt-8">
    <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-5 lg:grid-cols-10">
      {BRAND.map((c) => (
        <div>
          <div class:list={['h-14 rounded-lg border border-slate-200', c.cls]}></div>
          <p class="mt-1 text-xs text-slate-600">{c.name}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section title="ตัวอักษร" class="mt-10">
    <div class="mt-4 space-y-3">
      <p class="text-2xl font-medium tracking-tight text-slate-900">หัวเรื่องหน้า · Prompt 500 · 1.75rem</p>
      <p class="text-lg font-medium tracking-tight text-slate-900 sm:text-xl">หัวข้อ section · Prompt 500 · 1.125–1.25rem</p>
      <p class="text-base text-slate-700">เนื้อความ · Sarabun 400 · 1rem — ตัวเลข 0123456789 กว้างเท่ากันทุกหลัก</p>
      <p class="text-sm text-slate-600">ข้อความรอง · Sarabun 400 · 0.875rem</p>
      <p class="font-mono text-sm text-slate-700">โค้ดเท่านั้น · font-mono · {'{ "ok": true }'}</p>
    </div>
  </Section>

  <Section title="มุมโค้ง" class="mt-10">
    <div class="mt-4">
      <DataTable
        caption="ค่ามุมโค้งที่ใช้ในเว็บและบริบทของแต่ละค่า"
        columns={[{ header: 'คลาส' }, { header: 'ใช้กับ' }]}
        rows={RADII.map((r) => [r.name, r.use])}
      />
    </div>
  </Section>

  <Section title="การ์ด" class="mt-10">
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <Card as="div" size="lg">size="lg" — การ์ดหุ้มเครื่องมือและเนื้อหาหลัก</Card>
      <Card as="div" size="md">size="md" — การ์ดในกริด</Card>
      <Card as="div" size="sm">size="sm" — ชิปในรายการ</Card>
    </div>
  </Section>

  <Section title="ช่องกรอก ปุ่ม และสถานะ" class="mt-10">
    <Card as="div" class="mt-4">
      <DesignSystemDemo client:load />
    </Card>
  </Section>
</Base>
