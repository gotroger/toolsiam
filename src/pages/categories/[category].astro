---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ToolSearch from '@/components/ToolSearch';
import { toDiscoveryTool } from '@/components/tool-presentation';
import CategoryIcon from '@/components/CategoryIcon.astro';
import { getBrowsableCategories, getToolsByCategory, getVisibleTools, getActiveCategories } from '@/tools/registry';
import { resolveOgImage } from '@/tools/covers';
import { collectionPageJsonLd } from '@/lib/seo';
import { getCategoryUrl, getHomeUrl, getToolsUrl, getToolUrl } from '@/lib/routes';

// build เฉพาะหมวด active ที่ไม่มี landingPath — หมวด planned และ vertical จึงไม่มีหน้าซ้ำ intent (§8.3/§8.4)
export function getStaticPaths() {
  return getBrowsableCategories().map((category) => ({ params: { category: category.id }, props: { category } }));
}
const { category } = Astro.props;
const list = getToolsByCategory(category.id);
const path = getCategoryUrl(category);
const description = `เครื่องมือหมวด${category.name}: ${category.description} ใช้ฟรีบนเว็บ ไม่ต้องติดตั้ง`;
// ใช้ภาพของเครื่องมือตัวแรกในหมวดเป็นตัวแทน — หมวดที่ build ได้ต้องมีเครื่องมือเสมอ (§8.4)
const og = resolveOgImage(list[0]);
const crumbs = [
  { name: 'ทูลสยาม', path: getHomeUrl() },
  { name: 'เครื่องมือทั้งหมด', path: getToolsUrl() },
  { name: category.name, path },
];
const jsonLd = [
  collectionPageJsonLd({
    name: category.name,
    description,
    path,
    items: list.map((t) => ({ name: t.name, path: getToolUrl(t.slug) })),
  }),
];
---

<Base
  wide
  title={`${category.name} — เครื่องมือออนไลน์ ทูลสยาม`}
  description={description}
  jsonLd={jsonLd}
  ogImage={og.src}
  ogImageAlt={og.alt}
>
  <Breadcrumb items={crumbs} />
  <div class="mt-2 flex items-start gap-3">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
      <CategoryIcon category={category.id} class="h-[22px] w-[22px]" />
    </div>
    <div>
      <h1 class="text-[1.75rem] font-medium tracking-tight text-slate-900 sm:text-3xl">{category.name}</h1>
      <p class="mt-1.5 max-w-2xl text-slate-600">{category.description}</p>
    </div>
  </div>
  <div class="mt-6">
    <ToolSearch
      client:load
      tools={getVisibleTools().map(toDiscoveryTool)}
      categories={getActiveCategories()}
      initialCategory={category.id}
    />
  </div>
</Base>
