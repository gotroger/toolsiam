---
import Base from '@/layouts/Base.astro';
import ToolSearch from '@/components/ToolSearch';
import { tools } from '@/tools/registry';
---
<Base wide title="เครื่องมือทั้งหมด — ทูลสยาม" description={`รวมเครื่องมือออนไลน์ภาษาไทย ${tools.length} รายการ ค้นหาตามหมวดหมู่ ฟรีและพรีเมียม ใช้งานได้ทันทีบนเบราว์เซอร์`}>
  <h1 class="text-[1.75rem] font-bold tracking-tight text-slate-900 sm:text-3xl">เครื่องมือทั้งหมด</h1>
  <p class="mt-2 max-w-xl text-slate-600">ค้นหาหรือกรองตามหมวดหมู่ เครื่องมือฟรีใช้ได้ทันทีไม่ต้องสมัคร</p>
  <div class="mt-6">
    <ToolSearch client:load />
  </div>
</Base>
