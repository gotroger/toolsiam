---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import Section from '@/components/Section.astro';
import VerticalShell from '@/components/VerticalShell.astro';
import DreamSearch from '@/components/DreamSearch';
import { collectionPageJsonLd } from '@/lib/seo';
import { getDreamEntryUrl, getDreamUrl, getHomeUrl, getHoroscopeUrl } from '@/lib/routes';
import { DREAM_ENTRIES } from '@/content/dream/entries';

const title = 'ทำนายฝัน — ความหมายของความฝันตามตำราไทย';
const description = `รวมความหมายของความฝัน ${DREAM_ENTRIES.length} เรื่องตามตำราไทย ทั้งฝันเห็นงู ปลา ฟันหลุด น้ำ ไฟ และอื่น ๆ พร้อมเลขนำโชคตามความเชื่อและบริบทที่ทำให้ความหมายต่างกัน`;
---

<Base
  title={`${title} — ทูลสยาม`}
  description={description}
  wide
  jsonLd={[
    collectionPageJsonLd({
      name: title,
      description,
      path: getDreamUrl(),
      items: DREAM_ENTRIES.map((e) => ({ name: e.title, path: getDreamEntryUrl(e.slug) })),
    }),
  ]}
>
  <VerticalShell
    title="ทำนายฝัน"
    description={description}
    category="dream"
    gradient={['#faf5ff', '#e9d5ff']}
    crumbs={[
      { name: 'ทูลสยาม', path: getHomeUrl() },
      { name: 'ทำนายฝัน', path: getDreamUrl() },
    ]}
  >
    <Card>
      <DreamSearch client:load />
    </Card>

    <Section title="ทำไมคนเราถึงฝัน" class="mt-10">
      <div class="mt-2 max-w-[68ch] space-y-3 text-sm leading-relaxed text-slate-600">
        <p>
          ความฝันเกิดขึ้นระหว่างการนอนหลับและมักหยิบเรื่องที่ค้างอยู่ในความคิดของวันก่อนหน้ามาเรียบเรียงใหม่
          ตำราทำนายฝันของไทยจึงมักตีความความฝันเป็นสัญลักษณ์ของสิ่งที่กำลังเกิดในชีวิต
          มากกว่าจะเป็นการบอกเหตุการณ์ที่จะเกิดขึ้นตรง ๆ
        </p>
        <p>
          หน้าเหล่านี้รวบรวมความหมายตามตำราไว้เป็นข้อมูลอ้างอิงและความบันเทิง
          แต่ละเรื่องยังเขียนบริบทที่ทำให้ความหมายต่างกันไว้ด้วย เพราะตำราไทยแทบทุกเล่มตีความตามรายละเอียดของฝัน
          ไม่ได้ให้ความหมายเดียวกับทุกกรณี
        </p>
        <p>
          ถ้าฝันเรื่องเดิมซ้ำ ๆ จนกระทบการนอนหรือความรู้สึกในเวลากลางวัน
          การพูดคุยกับผู้เชี่ยวชาญด้านสุขภาพจิตช่วยได้มากกว่าการหาความหมายของความฝัน
        </p>
      </div>
    </Section>

    <p class="mt-8 text-sm text-slate-600">
      สนใจเรื่องราศีและสีมงคล ดูได้ที่{' '}
      <a href={getHoroscopeUrl()} class="text-brand-700 underline underline-offset-2 hover:text-brand-800"
        >หน้าดูดวงและความเชื่อ</a
      >
    </p>
  </VerticalShell>
</Base>
