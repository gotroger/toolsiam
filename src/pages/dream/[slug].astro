---
import Base from '@/layouts/Base.astro';
import Card from '@/components/Card.astro';
import { sectionHeading } from '@/components/headings';
import Section from '@/components/Section.astro';
import VerticalShell from '@/components/VerticalShell.astro';
import { DREAM_ENTRIES, DREAM_GROUPS, dreamBySlug } from '@/content/dream/entries';
import { getDreamEntryUrl, getDreamUrl, getHomeUrl } from '@/lib/routes';

export function getStaticPaths() {
  return DREAM_ENTRIES.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const groupLabel = DREAM_GROUPS.find((g) => g.id === entry.group)?.label ?? '';
const related = entry.related.map(dreamBySlug).filter((e) => e !== undefined);
const description = entry.meaning.length > 155 ? `${entry.meaning.slice(0, 152)}…` : entry.meaning;
---
<Base title={`${entry.title} หมายถึงอะไร — ทำนายฝัน ทูลสยาม`} description={description}>
  <VerticalShell
    title={entry.title}
    description={`ความหมายตามตำราไทย พร้อมบริบทที่ทำให้ความหมายต่างกัน · หมวด${groupLabel}`}
    category="dream"
    gradient={['#faf5ff', '#e9d5ff']}
    crumbs={[
      { name: 'ทูลสยาม', path: getHomeUrl() },
      { name: 'ทำนายฝัน', path: getDreamUrl() },
      { name: entry.title, path: getDreamEntryUrl(entry.slug) },
    ]}
  >
    <Card>
      <h2 class={sectionHeading}>ความหมายตามตำรา</h2>
      <p class="mt-2 text-slate-700">{entry.meaning}</p>
    </Card>

    <Section title="บริบทที่ทำให้ความหมายต่างกัน" class="mt-6">
      <p class="mt-1 text-sm text-slate-600">
        ตำราไทยแทบทุกเล่มตีความตามรายละเอียดของฝัน ไม่ได้ให้ความหมายเดียวกับทุกกรณี
      </p>
      <dl class="mt-4 space-y-3">
        {entry.contexts.map((c) => (
          <Card as="div" size="md">
            <dt class="font-medium text-slate-900">{c.when}</dt>
            <dd class="mt-1 text-sm text-slate-600">{c.meaning}</dd>
          </Card>
        ))}
      </dl>
    </Section>

    <Section title="แล้วควรทำอะไรต่อ" class="mt-6 rounded-xl border border-brand-600/20 bg-brand-50 p-4 sm:p-6">
      <p class="mt-2 text-slate-700">{entry.advice}</p>
    </Section>

    {related.length > 0 && (
      <Section title="ความฝันที่เกี่ยวข้อง" class="mt-8">
        <ul class="mt-3 grid gap-2 sm:grid-cols-3">
          {related.map((e) => (
            <li>
              <Card as="a" size="sm" class="block text-slate-800 transition-colors duration-150 hover:border-brand-600/40 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600" href={getDreamEntryUrl(e.slug)}>
                {e.title}
              </Card>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <p class="mt-8 text-sm text-slate-600">
      <a href={getDreamUrl()} class="text-brand-700 underline underline-offset-2 hover:text-brand-800">
        ← กลับไปค้นหาความฝันเรื่องอื่น
      </a>
    </p>
  </VerticalShell>
</Base>
