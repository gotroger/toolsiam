---
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import VerticalShell from '@/components/VerticalShell.astro';
import LuckyBalls from '@/components/dream/LuckyBalls';
import { DREAM_ENTRIES, DREAM_GROUPS, dreamBySlug } from '@/content/dream/entries';
import { luckyNumbersFor } from '@/content/dream/lucky-numbers';
import { getDreamEntryUrl, getDreamUrl, getHomeUrl } from '@/lib/routes';

export function getStaticPaths() {
  return DREAM_ENTRIES.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const groupLabel = DREAM_GROUPS.find((g) => g.id === entry.group)?.label ?? '';
const related = entry.related.map(dreamBySlug).filter((e) => e !== undefined);
const lucky = luckyNumbersFor(entry.slug);
const description = entry.meaning.length > 155 ? `${entry.meaning.slice(0, 152)}…` : entry.meaning;
---

<Base title={`${entry.title} หมายถึงอะไร เลขนำโชค — ทำนายฝัน ทูลสยาม`} description={description}>
  <VerticalShell
    title={entry.title}
    description={`ความหมายตามตำราไทย เลขนำโชค และบริบทที่ทำให้ความหมายต่างกัน · หมวด${groupLabel}`}
    category="dream"
    gradient={['#faf5ff', '#e9d5ff']}
    crumbs={[
      { name: 'ทูลสยาม', path: getHomeUrl() },
      { name: 'ทำนายฝัน', path: getDreamUrl() },
      { name: entry.title, path: getDreamEntryUrl(entry.slug) },
    ]}
  >
    {/* สรุปกับเลขนำโชคอยู่บนสุดคู่กัน — คนส่วนใหญ่เปิดมาหาสองอย่างนี้ ไม่ต้องอ่านทั้งหน้าก่อน */}
    <div class="dream-summary">
      <section class="dream-meaning" aria-labelledby="dream-meaning-title">
        <h2 id="dream-meaning-title">ความหมายตามตำรา</h2>
        <p>{entry.meaning}</p>
      </section>
      {
        lucky && (
          <aside class="dream-lucky" aria-labelledby="dream-lucky-title">
            <h2 id="dream-lucky-title">เลขนำโชค</h2>
            <LuckyBalls numbers={lucky} size="lg" />
            <p class="dream-lucky-label">เลขสองตัว</p>
            <ul class="dream-lucky-pairs">
              {lucky.pairs.map((pair) => (
                <li>{pair}</li>
              ))}
            </ul>
            <p class="dream-lucky-note">ตามความเชื่อเพื่อความบันเทิง ตำราแต่ละเล่มให้เลขต่างกัน</p>
          </aside>
        )
      }
    </div>

    <Section title="ฝันแบบไหน หมายถึงอะไร" class="mt-8">
      <dl class="dream-contexts">
        {
          entry.contexts.map((c) => (
            <div class="dream-context">
              <dt>
                <span aria-hidden="true">ถ้า</span>
                {c.when}
              </dt>
              <dd>{c.meaning}</dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <section class="dream-advice" aria-labelledby="dream-advice-title">
      <h2 id="dream-advice-title">แล้วควรทำอะไรต่อ</h2>
      <p>{entry.advice}</p>
    </section>

    {
      related.length > 0 && (
        <Section title="ความฝันที่เกี่ยวข้อง" class="mt-8">
          <ul class="dream-grid mt-3">
            {related.map((e) => {
              const n = luckyNumbersFor(e.slug);
              return (
                <li>
                  <a class="dream-card" href={getDreamEntryUrl(e.slug)}>
                    <span class="dream-card-top">
                      <span class="dream-card-title">{e.title}</span>
                      {n && <LuckyBalls numbers={n} />}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </Section>
      )
    }

    <p class="mt-8 text-sm text-slate-600">
      <a href={getDreamUrl()} class="text-brand-700 underline underline-offset-2 hover:text-brand-800">
        ← กลับไปค้นหาความฝันเรื่องอื่น
      </a>
    </p>
  </VerticalShell>
</Base>
