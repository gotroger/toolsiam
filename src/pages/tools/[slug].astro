---
import Base from '@/layouts/Base.astro';
import ToolShell from '@/components/ToolShell.astro';
import ToolIsland from '@/tools/ToolIsland';
import { tools } from '@/tools/registry';
import { toolJsonLd } from '@/lib/seo';
import { resolveOgImage } from '@/tools/covers';
import { absoluteUrl, getToolUrl } from '@/lib/routes';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}
const { tool } = Astro.props;
const url = absoluteUrl(getToolUrl(tool.slug));
const og = resolveOgImage(tool);
---

<Base
  title={`${tool.name} — ทูลสยาม`}
  description={tool.description}
  jsonLd={toolJsonLd(tool, url)}
  ogImage={og.src}
  ogImageAlt={og.alt}
>
  <ToolShell tool={tool}>
    <ToolIsland client:load slug={tool.slug} />
    <noscript>กรุณาเปิด JavaScript ในเบราว์เซอร์เพื่อใช้เครื่องคำนวณ</noscript>
  </ToolShell>
</Base>
