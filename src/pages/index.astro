---
import Base from '@/layouts/Base.astro';
import ToolCard from '@/components/ToolCard.astro';
import ToolSearch from '@/components/ToolSearch';
import CategoryPill from '@/components/CategoryPill';
import ToolIcon from '@/components/ToolIcon';
import SectionHeader from '@/components/SectionHeader.astro';
import LotteryBanner from '@/components/lottery/LotteryBanner.astro';
import { toDiscoveryTool } from '@/components/tool-presentation';
import { getActiveCategories, getFeaturedTools, getVisibleTools } from '@/tools/registry';
import { getCategoryUrl, getToolsUrl, getToolUrl, getDreamUrl, getLotteryCheckUrl } from '@/lib/routes';
import { organizationJsonLd, websiteJsonLd } from '@/lib/seo';

const categories = getActiveCategories();
const featured = getFeaturedTools(7);
const tools = getVisibleTools().map(toDiscoveryTool);
const quickTools = [
  { name: 'คำนวณภาษี', href: getToolUrl('thai-income-tax') },
  { name: 'เงินเดือนสุทธิ', href: getToolUrl('net-salary') },
  { name: 'ตรวจหวย', href: getLotteryCheckUrl() },
  { name: 'ผ่อนรถ', href: getToolUrl('car-loan') },
  { name: 'ทำนายฝัน', href: getDreamUrl() },
];
const verticals = categories.filter((c) => c.landingPath && c.id !== 'lottery');
---

<Base
  wide
  title="ทูลสยาม — เครื่องมือออนไลน์ภาษาไทย ใช้ฟรี"
  description="รวมเครื่องมือออนไลน์ใช้ง่าย คำนวณภาษี ผ่อนบ้าน บาทถ้วน QR PromptPay JSON และอีกมาก ใช้ฟรีบนเบราว์เซอร์ ไม่ต้องติดตั้ง"
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  <section class="discovery-hero" aria-labelledby="home-title">
    <div class="hero-orbit hero-orbit-left" aria-hidden="true"><ToolIcon category="qr" /><span>฿</span></div>
    <div class="hero-orbit hero-orbit-right" aria-hidden="true">
      <ToolIcon category="date" /><ToolIcon category="loan" slug="home-loan" />
    </div>
    <p class="hero-eyebrow"><span aria-hidden="true"></span> {tools.length} เครื่องมือ · ภาษาไทย · ใช้ฟรี</p>
    <h1 id="home-title">เรื่องประจำวัน<br class="sm:hidden" /> <span>จัดการได้ในไม่กี่คลิก</span></h1>
    <p class="hero-description">
      เครื่องมือออนไลน์สำหรับทุกเรื่องในชีวิตประจำวัน<br class="sm:hidden" /> คำนวณ แปลงค่า เช็กข้อมูล จบในที่เดียว
    </p>
    <ToolSearch client:load mode="command" tools={tools} categories={categories} />
    <div class="quick-tools">
      <span>ลองใช้</span>{
        quickTools.map((tool) => (
          <a href={tool.href}>
            {tool.name}
            <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>

  <nav id="categories" class="discovery-categories" aria-label="หมวดหมู่เครื่องมือ">
    <div class="category-pills">
      <CategoryPill href={getToolsUrl()} />{
        categories.map((category) => <CategoryPill category={category.id} href={getCategoryUrl(category)} />)
      }
    </div>
  </nav>

  <section id="featured" class="discovery-section">
    <SectionHeader
      title="เครื่องมือแนะนำ"
      description="เลือกเครื่องมือ แล้วเริ่มใช้งานได้เลย"
      href={getToolsUrl()}
      linkLabel={`ดูทั้งหมด ${tools.length} เครื่องมือ`}
    />
    <div class="bento-grid">{featured.map((tool, index) => <ToolCard tool={tool} featured={index === 0} />)}</div>
  </section>

  <div class="utility-strip">
    <div>
      <ToolIcon category="qr" /><span
        ><strong>รับเงินสะดวกขึ้น</strong><small>สร้าง QR PromptPay พร้อมยอดเงิน</small></span
      >
    </div><a href={getToolUrl('promptpay-qr')}>สร้าง QR รับเงิน <span aria-hidden="true">↗</span></a>
  </div>
  <LotteryBanner />

  <section class="discovery-section" id="verticals">
    <SectionHeader title="ดวงและความฝัน" description="สำรวจความหมายตามความเชื่อ เพื่อความบันเทิง" />
    <div class="vertical-grid">
      {
        verticals.map((category) => (
          <a class="vertical-tile" data-category={category.id} href={getCategoryUrl(category)}>
            <>
              <span class="tool-icon">
                <ToolIcon category={category.id} />
              </span>
              <span>
                <>
                  <h3>{category.name}</h3>
                  <p>{category.description}</p>
                </>
              </span>
              <span class="tile-arrow" aria-hidden="true">
                ↗
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
</Base>
