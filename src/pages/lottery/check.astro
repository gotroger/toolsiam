---
import Base from '@/layouts/Base.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { Disclaimer } from '@/components/ui';
import LotteryCheck from '@/lottery/LotteryCheck';
import { faqJsonLd } from '@/lib/seo';
import { getHomeUrl, getLotteryCheckUrl, getLotteryUrl } from '@/lib/routes';
import { listDraws } from '@/lottery/draws';
import { CHECK_DESCRIPTION, CHECK_HOW_TO, CHECK_TITLE, LOTTERY_DISCLAIMER, LOTTERY_FAQ, LOTTERY_TITLE } from '@/lottery/content';

// ข้อมูลงวดถูก build ไปกับหน้า — island ไม่ต้องเรียก API และเลขที่ผู้ใช้กรอกไม่ออกจากเบราว์เซอร์
const draws = listDraws();
const crumbs = [
  { name: 'ทูลสยาม', path: getHomeUrl() },
  { name: LOTTERY_TITLE, path: getLotteryUrl() },
  { name: CHECK_TITLE, path: getLotteryCheckUrl() },
];
---
<Base title={`${CHECK_TITLE} — ทูลสยาม`} description={CHECK_DESCRIPTION} jsonLd={[faqJsonLd(LOTTERY_FAQ)]}>
  <Breadcrumb items={crumbs} />
  <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-[1.75rem]">{CHECK_TITLE}</h1>
  <p class="mt-2 max-w-3xl text-slate-600">{CHECK_DESCRIPTION}</p>

  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-4 shadow-[0_1px_2px_0_rgb(16_24_40/0.04)] sm:p-6">
    <LotteryCheck client:load draws={draws} lotteryUrl={getLotteryUrl()} />
  </section>

  <section class="mt-10 grid gap-8 md:grid-cols-2">
    <div>
      <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">วิธีใช้งาน</h2>
      <ol class="mt-3 list-decimal space-y-1 pl-5 text-slate-700">
        {CHECK_HOW_TO.map((step) => <li>{step}</li>)}
      </ol>
    </div>
    <div>
      <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">คำถามที่พบบ่อย</h2>
      <dl class="mt-3 space-y-3">
        {LOTTERY_FAQ.map((f) => (
          <div>
            <dt class="font-medium">{f.q}</dt>
            <dd class="text-slate-600">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="mt-8"><Disclaimer>{LOTTERY_DISCLAIMER}</Disclaimer></div>
</Base>
