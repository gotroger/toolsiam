---
import Base from '@/layouts/Base.astro';
---
<Base title="ไม่พบหน้าที่ต้องการ — ทูลสยาม" description="ไม่พบหน้าที่คุณต้องการ ลองค้นหาเครื่องมือจากหน้ารวมเครื่องมือทั้งหมด">
  <section class="py-16 text-center">
    <h1 class="text-3xl font-bold">ไม่พบหน้านี้ (404)</h1>
    <p class="mt-3 text-slate-600">ลิงก์อาจผิดหรือเครื่องมือถูกย้ายไปแล้ว</p>
    <a href="/tools" class="mt-6 inline-block rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white hover:bg-brand-700">ดูเครื่องมือทั้งหมด</a>
  </section>
</Base>
