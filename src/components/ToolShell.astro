---
import ToolHelp from './ToolHelp.astro';
import ToolIcon from './ToolIcon';
import { toolPresentation } from './tool-presentation';
import type { ToolMeta } from '@/tools/types';
import { getCategory, getRelatedTools } from '@/tools/registry';
import ToolCard from './ToolCard.astro';
import Breadcrumb from './Breadcrumb.astro';
import Card from './Card.astro';
import DataTable from './DataTable.astro';
import Section from './Section.astro';
import { TrustPanel } from './ui';
import { cardGridTwo, cardGridItem } from './grids';
import { getCategoryUrl, getHomeUrl, getToolsUrl, getToolUrl } from '@/lib/routes';
interface Props {
  tool: ToolMeta;
}
const { tool } = Astro.props;
// เครื่องมือที่ปลดระวางมี category เป็น null — ไม่มีชิปหมวดและไม่มี related (§18.3)
const cat = tool.category ? getCategory(tool.category) : null;
const related = getRelatedTools(tool, 4);
// breadcrumb ชี้ /tools ไม่ใช่หมวด เพราะ URL ของเครื่องมือไม่ฝังหมวด (§25.2)
// หมวดยังแสดงอยู่เป็นชิปลิงก์ใต้หัวข้อ
const crumbs = [
  { name: 'ทูลสยาม', path: getHomeUrl() },
  { name: 'เครื่องมือทั้งหมด', path: getToolsUrl() },
  { name: tool.name, path: getToolUrl(tool.slug) },
];
---

<Breadcrumb items={crumbs} />
<header class="tool-page-heading" data-category={tool.category}>
  <span class="tool-icon"><ToolIcon category={tool.category} slug={tool.slug} /></span>
  <div>
    <h1>{tool.name}</h1><p>{toolPresentation(tool).description}</p>
    {
      cat && (
        <a class="tool-page-category" href={getCategoryUrl(cat)}>
          {cat.name} <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</header>
<Card size="workspace" aria-label={tool.name}>
  <div class="workspace-bar"><span>พื้นที่ทำงาน</span><span>ใช้ฟรี · ไม่ต้องสมัคร</span></div>
  <div class="workspace-content"><slot /></div>
</Card>
<div class="mt-6 text-sm leading-relaxed text-slate-600"><p>{tool.description}</p></div>

<!--
  แผงความน่าเชื่อถือ (§17.2) — render อัตโนมัติจาก meta ไม่ต้องให้แต่ละเครื่องมือประกอบเอง
  ไม่มี client directive จึงออกเป็น HTML ล้วน ไม่เพิ่ม JS ให้หน้า
-->
<TrustPanel rates={tool.rates} assumptions={tool.assumptions} disclaimer={tool.disclaimer} />

{
  tool.examples && (
    <Section title={tool.examples.heading} lead={tool.examples.note} class="mt-10">
      <div class="mt-4">
        <DataTable
          caption={tool.examples.heading}
          minWidth="30rem"
          columns={tool.examples.columns.map((c, i) => ({ header: c, align: i === 0 ? 'left' : 'right' }))}
          rows={tool.examples.rows}
        />
      </div>
    </Section>
  )
}

<ToolHelp howTo={tool.howTo} faq={tool.faq} />

{
  related.length > 0 && (
    <Section title="เครื่องมือที่เกี่ยวข้อง" class="mt-10">
      <div class:list={['mt-5', cardGridTwo]}>
        {related.map((t) => (
          <div class:list={[cardGridItem]}>
            <ToolCard tool={t} />
          </div>
        ))}
      </div>
    </Section>
  )
}
