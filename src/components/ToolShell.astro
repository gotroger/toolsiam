---
import type { ToolMeta } from '@/tools/types';
import { getCategory, getRelatedTools } from '@/tools/registry';
import ToolCard from './ToolCard.astro';
import Breadcrumb from './Breadcrumb.astro';
import { TrustPanel } from './ui';
import { cardGridTwo, cardGridItem } from './grids';
import { getCategoryUrl, getHomeUrl, getToolsUrl, getToolUrl } from '@/lib/routes';
interface Props { tool: ToolMeta }
const { tool } = Astro.props;
// เครื่องมือที่ปลดระวางมี category เป็น null — ไม่มีชิปหมวดและไม่มี related (§18.3)
const cat = tool.category ? getCategory(tool.category) : null;
const related = getRelatedTools(tool, 4);
// breadcrumb ชี้ /tools ไม่ใช่หมวด เพราะ URL ของเครื่องมือไม่ฝังหมวด (§25.2)
// หมวดยังแสดงอยู่เป็นชิปลิงก์ใต้หัวข้อ
const crumbs = [
  { name: 'ทูลสยาม', path: getHomeUrl() },
  { name: 'เครื่องมือทั้งหมด', path: getToolsUrl() },
  { name: tool.name, path: getToolUrl(tool.slug) },
];
---
<Breadcrumb items={crumbs} />
<h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-[1.75rem]">{tool.name}</h1>
<p class="mt-2 max-w-3xl text-slate-600">{tool.description}</p>
{cat && (
  <a
    href={getCategoryUrl(cat)}
    class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1 text-xs text-slate-600 transition-colors duration-150 hover:border-brand-600/40 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
  >
    <span aria-hidden="true">{cat.icon}</span> {cat.name}
  </a>
)}

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-4 shadow-[0_1px_2px_0_rgb(16_24_40/0.04)] sm:p-6">
  <slot />
</section>

<!--
  แผงความน่าเชื่อถือ (§17.2) — render อัตโนมัติจาก meta ไม่ต้องให้แต่ละเครื่องมือประกอบเอง
  ไม่มี client directive จึงออกเป็น HTML ล้วน ไม่เพิ่ม JS ให้หน้า
-->
<TrustPanel rates={tool.rates} assumptions={tool.assumptions} disclaimer={tool.disclaimer} />

{tool.examples && (
  <section class="mt-10">
    <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">{tool.examples.heading}</h2>
    <p class="mt-1 text-sm text-slate-600">{tool.examples.note}</p>
    <div class="mt-4 overflow-x-auto rounded-[10px] border border-slate-200">
      <table class="w-full min-w-[30rem] border-collapse text-sm">
        <caption class="sr-only">{tool.examples.heading}</caption>
        <thead>
          <tr class="bg-slate-50 text-slate-600">
            {tool.examples.columns.map((c, i) => (
              <th scope="col" class:list={['border-b border-slate-200 px-3 py-2 font-medium', i === 0 ? 'text-left' : 'text-right']}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {tool.examples.rows.map((row) => (
            <tr class="even:bg-slate-50/60">
              {row.map((cell, i) => (
                <td class:list={['border-b border-slate-100 px-3 py-2', i === 0 ? 'text-slate-800' : 'text-right tabular-nums text-slate-700']}>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}

<section class="mt-10 grid gap-8 md:grid-cols-2">
  <div>
    <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">วิธีใช้งาน</h2>
    <ol class="mt-3 list-decimal space-y-1 pl-5 text-slate-700">
      {tool.howTo.map((step) => <li>{step}</li>)}
    </ol>
  </div>
  <div>
    <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">คำถามที่พบบ่อย</h2>
    <dl class="mt-3 space-y-3">
      {tool.faq.map((f) => (
        <div>
          <dt class="font-medium">{f.q}</dt>
          <dd class="text-slate-600">{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

{related.length > 0 && (
  <section class="mt-10">
    <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">เครื่องมือที่เกี่ยวข้อง</h2>
    <div class:list={['mt-5', cardGridTwo]}>
      {related.map((t) => <div class:list={[cardGridItem]}><ToolCard tool={t} /></div>)}
    </div>
  </section>
)}
