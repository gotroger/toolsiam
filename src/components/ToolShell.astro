---
import type { ToolMeta } from '@/tools/types';
import { getCategory, getToolsByCategory } from '@/tools/registry';
import ToolCard from './ToolCard.astro';
import { cardGridTwo, cardGridItem } from './grids';
interface Props { tool: ToolMeta }
const { tool } = Astro.props;
const cat = getCategory(tool.category);
const related = getToolsByCategory(tool.category).filter((t) => t.slug !== tool.slug).slice(0, 4);
---
<nav class="text-sm text-slate-500" aria-label="breadcrumb">
  <a href="/" class="hover:underline">หน้าแรก</a> › <a href={`/c/${cat.id}`} class="hover:underline">{cat.name}</a>
</nav>
<div class="mt-2 flex flex-wrap items-center gap-2">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-[1.75rem]">{tool.name}</h1>
  <span class:list={['rounded-md px-1.5 py-0.5 text-[0.6875rem] font-medium ring-1 ring-inset', tool.tier === 'premium' ? 'bg-amber-50 text-amber-700 ring-amber-600/20' : 'bg-brand-50 text-brand-700 ring-brand-600/15']}>
    {tool.tier === 'premium' ? 'พรีเมียม' : 'ฟรี'}
  </span>
</div>
<p class="mt-2 max-w-3xl text-slate-600">{tool.description}</p>

<section class="mt-6 rounded-xl border border-slate-200 bg-white p-4 shadow-[0_1px_2px_0_rgb(16_24_40/0.04)] sm:p-6">
  <slot />
</section>

<section class="mt-10 grid gap-8 md:grid-cols-2">
  <div>
    <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">วิธีใช้งาน</h2>
    <ol class="mt-3 list-decimal space-y-1 pl-5 text-slate-700">
      {tool.howTo.map((step) => <li>{step}</li>)}
    </ol>
  </div>
  <div>
    <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">คำถามที่พบบ่อย</h2>
    <dl class="mt-3 space-y-3">
      {tool.faq.map((f) => (
        <div>
          <dt class="font-medium">{f.q}</dt>
          <dd class="text-slate-600">{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

{related.length > 0 && (
  <section class="mt-10">
    <h2 class="text-lg font-bold tracking-tight text-slate-900 sm:text-xl">เครื่องมืออื่นในหมวด {cat.name}</h2>
    <div class:list={['mt-5', cardGridTwo]}>
      {related.map((t) => <div class:list={[cardGridItem]}><ToolCard tool={t} /></div>)}
    </div>
  </section>
)}
