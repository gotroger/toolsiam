---
import CategoryIcon from '@/components/CategoryIcon.astro';
import LiveDrawNotice from '@/components/lottery/LiveDrawNotice';
import { latestDraw } from '@/data/lottery';
import { formatThaiDate } from '@/lib/thai-date';
import { getLotteryCheckUrl, getLotteryLatestUrl, getLotteryUrl } from '@/lib/routes';

const draw = latestDraw();
const prizes = draw
  ? [
      { label: 'รางวัลที่ 1', numbers: draw.prizes.first, kind: 'first' },
      { label: 'เลขท้าย 2 ตัว', numbers: draw.prizes.twoDigitBack, kind: 'two' },
      { label: 'เลขหน้า 3 ตัว', numbers: draw.prizes.threeDigitFront, kind: 'three' },
      { label: 'เลขท้าย 3 ตัว', numbers: draw.prizes.threeDigitBack, kind: 'three' },
    ]
  : [];
---

{
  draw && (
    <section id="lottery" class="lottery-section" aria-labelledby="lottery-heading">
      <div class="lottery-board">
        <header class="lottery-heading">
          <div class="lottery-title">
            <>
              <CategoryIcon category="lottery" class="h-5 w-5" />
              <h2 id="lottery-heading">ผลสลากกินแบ่งรัฐบาลงวดล่าสุด</h2>
            </>
          </div>
          <div class="lottery-draw-meta">
            <p>
              งวดวันที่ <time datetime={draw.drawDate}>{formatThaiDate(draw.drawDate, { style: 'medium' })}</time>
            </p>
            <span class:list={['lottery-status', draw.status === 'verified' ? 'text-brand-700' : 'text-amber-700']}>
              {draw.status === 'verified' && (
                <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="m3 8 3 3 7-7" />
                </svg>
              )}
              {draw.status === 'verified' ? 'ตรวจกับประกาศแล้ว' : 'รอการตรวจสอบซ้ำ'}
            </span>
          </div>
        </header>
        <dl class="lottery-results">
          {prizes.map((prize) => (
            <div class="lottery-prize" data-prize={prize.kind}>
              <dt>{prize.label}</dt>
              <dd>
                {prize.numbers.map((number) => (
                  <span>{number}</span>
                ))}
              </dd>
            </div>
          ))}
        </dl>
        <footer class="lottery-actions">
          <a class="lottery-all-results" href={getLotteryLatestUrl()}>
            ดูผลรางวัลทั้งหมด <span aria-hidden="true">↗</span>
          </a>
          <a class="lottery-check" href={getLotteryCheckUrl()}>
            ตรวจสลากของฉัน <span aria-hidden="true">→</span>
          </a>
        </footer>
      </div>
      <p class="lottery-source">
        ตรวจสอบเบื้องต้น · การขึ้นเงินรางวัลให้ยึด{' '}
        <a href={draw.sourceUrl} rel="nofollow noopener" target="_blank">
          ประกาศสำนักงานสลากกินแบ่งรัฐบาล
        </a>{' '}
        · <a href={getLotteryUrl()}>หวยและสลากทั้งหมด</a>
      </p>
      <LiveDrawNotice client:idle staticDrawDate={draw.drawDate} />
    </section>
  )
}
