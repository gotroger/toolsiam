---
import CategoryIcon from '@/components/CategoryIcon.astro';
import LiveDrawNotice from '@/components/lottery/LiveDrawNotice';
import { latestDraw } from '@/data/lottery';
import { formatThaiDate } from '@/lib/thai-date';
import { getLotteryCheckUrl, getLotteryLatestUrl, getLotteryUrl } from '@/lib/routes';

/**
 * แบนเนอร์ผลหวยงวดล่าสุดบนหน้าแรก
 *
 * หวยเป็น vertical ที่คนเข้ามาหาบ่อยที่สุดและมี "คำตอบ" ที่ตอบได้ในบรรทัดเดียว
 * จึงยกออกจากแถวรวมของ vertical มาเป็นแบนเนอร์เดี่ยว และแสดงเลขจริงเลย
 * ไม่ใช่แค่ลิงก์ไปหน้าอื่น — คนที่มาถามว่า "งวดนี้ออกอะไร" ต้องได้คำตอบตั้งแต่หน้าแรก
 *
 * ดีไซน์เป็นการ์ดขาวชุดเดียวกับส่วนอื่นของหน้าแรก ไม่ใช่บล็อกสีเข้ม —
 * ตัวเลขที่ใหญ่พอเป็นตัวดึงสายตาอยู่แล้ว พื้นหลังจึงไม่ต้องช่วยแข่ง
 *
 * รางวัลที่ 1 กับเลขท้าย 2 ตัวถูกวางเป็นคู่ขนาดเท่ากันโดยตั้งใจ — สองอย่างนี้คือสิ่งที่คนตรวจก่อน
 * และเลขท้าย 2 ตัวเป็นรางวัลที่คนถูกมากที่สุด จึงไม่ควรเล็กกว่ารางวัลที่ 1
 *
 * ⚠️ แสดงผลรางวัลบนหน้าแรกแปลว่าหน้าแรกก็ต้องอยู่ใต้กฎ L5 (§28.3) ด้วย —
 * ห้ามแสดงงวดเก่าเงียบ ๆ ราวกับเป็นงวดล่าสุด จึงพ่วง LiveDrawNotice มาทั้งก้อน
 * (ได้งวดใหม่กว่าจาก KV → แจ้ง · ข้อมูลเก่าเกินเกณฑ์ → เตือน · Worker ล่ม → เงียบ)
 *
 * ไม่มีข้อมูลงวด = ไม่ render อะไรเลย ตามกฎเดียวกับหน้า /lottery (§8.4)
 */
const draw = latestDraw();

/** สองรางวัลหลักที่วางคู่กันขนาดเท่ากัน */
const HERO = [
  { name: 'รางวัลที่ 1', numbers: draw?.prizes.first ?? [] },
  { name: 'เลขท้าย 2 ตัว', numbers: draw?.prizes.twoDigitBack ?? [] },
];
/** รางวัลรองที่ยังอยู่ในกลุ่มที่คนดูก่อนเสมอ */
const SECONDARY = [
  { name: 'เลขหน้า 3 ตัว', numbers: draw?.prizes.threeDigitFront ?? [] },
  { name: 'เลขท้าย 3 ตัว', numbers: draw?.prizes.threeDigitBack ?? [] },
];
---
{draw && (
  <section id="lottery" class="mt-8 scroll-mt-24 sm:mt-10">
    <div class="relative flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_1px_2px_0_rgb(16_24_40/0.04)] sm:p-6">
      {/*
        จอแคบเรียง หัวเรื่อง → ตัวเลข → ปุ่ม เพราะคนที่เปิดหน้าแรกมาถามว่า "งวดนี้ออกอะไร"
        ต้องเห็นเลขก่อนปุ่ม · จอกว้างมีที่พอให้ปุ่มกลับไปอยู่แถวเดียวกับหัวเรื่องทางขวา
      */}
      <div class="order-1 flex items-center gap-3 lg:pr-72">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
          <CategoryIcon category="lottery" class="h-5 w-5" />
        </span>
        <div>
          <h2 class="text-[1.0625rem] tracking-tight text-slate-900 sm:text-lg">ผลสลากกินแบ่งรัฐบาลงวดล่าสุด</h2>
          <p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-slate-500">
            <span>งวดวันที่ {formatThaiDate(draw.drawDate, { style: 'medium' })}</span>
            <span aria-hidden="true" class="text-slate-300">·</span>
            <span class={draw.status === 'verified' ? 'text-brand-700' : 'text-amber-700'}>
              {draw.status === 'verified' ? 'ตรวจกับประกาศแล้ว' : 'รอการตรวจสอบซ้ำ'}
            </span>
          </p>
        </div>
      </div>

      <div class="order-4 mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm lg:absolute lg:right-6 lg:top-6 lg:mt-0">
        <a
          href={getLotteryCheckUrl()}
          class="inline-flex items-center rounded-[10px] border border-brand-600/30 bg-brand-50 px-3.5 py-2 font-medium text-brand-700 transition-colors duration-150 hover:border-brand-600/50 hover:bg-brand-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2"
        >
          ตรวจสลากของฉัน
        </a>
        <a
          href={getLotteryLatestUrl()}
          class="rounded-lg font-medium text-slate-600 transition-colors duration-150 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
        >
          ผลรางวัลทั้งหมด
        </a>
      </div>

      {/* รางวัลที่ 1 และเลขท้าย 2 ตัว — ขนาดเท่ากัน กว้างเท่ากัน */}
      <div class="order-2 mt-5 grid gap-3 sm:grid-cols-2">
        {HERO.map((prize) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3.5">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{prize.name}</p>
            <p class="mt-1 flex flex-wrap gap-x-5 text-[2.5rem] font-medium leading-none tracking-[0.06em] tabular-nums text-slate-900 sm:text-[3rem]">
              {prize.numbers.map((n) => <span>{n}</span>)}
            </p>
          </div>
        ))}
      </div>

      <div class="order-3 mt-3 grid gap-3 sm:grid-cols-2">
        {SECONDARY.map((prize) => (
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 rounded-xl border border-slate-200 px-4 py-3">
            <p class="text-xs font-medium text-slate-500">{prize.name}</p>
            <p class="flex flex-wrap gap-x-4 text-xl leading-none tracking-[0.06em] tabular-nums text-slate-900">
              {prize.numbers.map((n) => <span>{n}</span>)}
            </p>
          </div>
        ))}
      </div>

      <p class="order-5 mt-4 text-xs leading-relaxed text-slate-500">
        ข้อมูลเพื่อการตรวจสอบเบื้องต้น การขึ้นเงินรางวัลต้องยึด
        <a
          href={draw.sourceUrl}
          rel="nofollow noopener"
          target="_blank"
          class="text-slate-600 underline underline-offset-2 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
        >ประกาศของสำนักงานสลากกินแบ่งรัฐบาล</a>
        เสมอ · <a href={getLotteryUrl()} class="text-slate-600 underline underline-offset-2 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600">หน้าหวยและสลากทั้งหมด</a>
      </p>
    </div>

    <div class="mt-3"><LiveDrawNotice client:idle staticDrawDate={draw.drawDate} /></div>
  </section>
)}
