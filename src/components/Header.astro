---
/**
 * Header หลักของเว็บ — sticky, พื้นขาว, เส้นคั่นบาง, เบลอพื้นหลังเมื่อเลื่อนลง
 * ลิงก์ทุกตัวชี้ไปยัง route/anchor ที่มีอยู่จริงเท่านั้น
 */
import { getHomeUrl, getToolsUrl } from '@/lib/routes';
const links = [
  { href: getToolsUrl(), label: 'เครื่องมือทั้งหมด', match: (p: string) => p.startsWith('/tools') },
  { href: `${getHomeUrl()}#categories`, label: 'หมวดหมู่', match: (p: string) => p.startsWith('/categories/') },
];
const current = Astro.url.pathname;
---
<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-surface transition-shadow duration-200 data-[scrolled]:border-slate-200 data-[scrolled]:bg-surface/85 data-[scrolled]:shadow-[0_1px_2px_0_rgb(16_24_40/0.06)] data-[scrolled]:backdrop-blur-md supports-[backdrop-filter]:data-[scrolled]:bg-surface/80"
>
  <div class="site-container flex h-16 items-center justify-between gap-4 sm:h-[68px]">
    <a
      href="/"
      class="group flex shrink-0 items-center rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-4"
    >
      <img
        src="/logo.png"
        alt="ทูลสยาม"
        width="401"
        height="96"
        decoding="async"
        class="h-7 w-auto sm:h-8"
      />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="เมนูหลัก">
      {links.map((l) => {
        const active = l.match(current) || current === l.href;
        return (
          <a
            href={l.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600',
              active ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900',
            ]}
          >
            {l.label}
          </a>
        );
      })}
      <a
        href={getToolsUrl()}
        aria-label="ค้นหาเครื่องมือ"
        class="ml-1 flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-500 transition-colors duration-150 hover:border-brand-600/40 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600"
      >
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" class="h-[18px] w-[18px]" aria-hidden="true">
          <circle cx="9" cy="9" r="6" />
          <path d="m13.5 13.5 3.5 3.5" stroke-linecap="round" />
        </svg>
      </a>
    </nav>

    <div class="flex items-center gap-2">
    <button
      type="button"
      id="theme-toggle"
      aria-pressed="false"
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition-colors duration-150 hover:border-brand-600/40 hover:text-brand-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 md:h-9 md:w-9"
    >
      <span class="sr-only" id="theme-toggle-label">สลับเป็นโหมดมืด</span>
      <svg data-theme-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-[18px] w-[18px]" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10 1.4 1.4m0-12.8-1.4 1.4m-10 10-1.4 1.4" />
      </svg>
      <svg data-theme-icon="dark" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
      </svg>
    </button>

    <button
      type="button"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="flex h-10 w-10 items-center justify-center rounded-lg border border-slate-200 text-slate-700 transition-colors duration-150 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 md:hidden"
    >
      <span class="sr-only">เปิดเมนู</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
    </div>
  </div>

  <nav id="mobile-nav" hidden class="border-t border-slate-200 bg-surface md:hidden" aria-label="เมนูหลัก (มือถือ)">
    <div class="site-container flex flex-col py-2">
      {links.map((l) => {
        const active = l.match(current) || current === l.href;
        return (
          <a
            href={l.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2.5 text-[0.9375rem] font-medium',
              active ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50',
            ]}
          >
            {l.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<script>
  /**
   * สลับธีม — เก็บเฉพาะเมื่อผู้ใช้เลือกเอง
   *
   * ไม่มีค่าใน localStorage = ตามระบบ (prefers-color-scheme ทำงานเอง)
   * กดครั้งแรกจึงบันทึกค่าตรงข้ามกับที่เห็นอยู่ตอนนั้น ไม่ใช่ตรงข้ามกับ 'light' เสมอ
   *
   * ค่าเริ่มต้นถูกตั้งไว้แล้วโดยสคริปต์ใน <head> ของ Base.astro (กันหน้าขาววาบ)
   * ที่นี่จึงเหลือแค่การกดสลับกับอัปเดตหน้าตาปุ่ม
   */
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    const root = document.documentElement;
    const label = document.getElementById('theme-toggle-label');
    const sun = themeToggle.querySelector('[data-theme-icon="light"]');
    const moon = themeToggle.querySelector('[data-theme-icon="dark"]');
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

    const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && systemDark.matches);

    const paint = () => {
      const dark = isDark();
      themeToggle.setAttribute('aria-pressed', String(dark));
      if (label) label.textContent = dark ? 'สลับเป็นโหมดสว่าง' : 'สลับเป็นโหมดมืด';
      if (sun instanceof HTMLElement) sun.hidden = dark;
      if (moon instanceof HTMLElement) moon.hidden = !dark;
    };

    themeToggle.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('toolsiam-theme', next); } catch { /* โหมดส่วนตัว */ }
      paint();
    });

    // ผู้ใช้ที่ยังไม่เคยกดเลือก ต้องเปลี่ยนตามระบบทันทีโดยไม่ต้องรีเฟรช
    systemDark.addEventListener('change', () => { if (!root.dataset.theme) paint(); });
    paint();
  }

  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');

  if (header) {
    const onScroll = () => {
      if (window.scrollY > 4) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Esc ปิดเมนูแล้วคืนโฟกัสให้ปุ่ม ไม่ใช่ปล่อยโฟกัสค้างในเมนูที่ซ่อนไปแล้ว
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // แตะลิงก์ในเมนูแล้วปิดเอง — ลิงก์ '#categories' อยู่หน้าเดียวกัน ถ้าไม่ปิดเมนูจะบังจุดที่เลื่อนไปถึง
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    /**
     * ขยายจอข้ามไป md แล้วต้องปิด — เมนูมือถือเป็น `md:hidden` จึงหายไปจากตาแต่ยัง hidden=false อยู่
     * พอย่อจอกลับมาเมนูจะเด้งค้างเปิดเองทั้งที่ผู้ใช้ไม่ได้กด และ aria-expanded ก็ค้างเป็น true
     */
    const desktop = window.matchMedia('(min-width: 768px)');
    desktop.addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }
</script>
