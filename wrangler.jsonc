{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolsiam",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "toolsiam.com", "custom_domain": true },
    { "pattern": "www.toolsiam.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "preview_urls": false,

  // อ่านผลงวดล่าสุดที่ Worker cron (workers/lottery-cron/) เขียนไว้ — เว็บนี้อ่านอย่างเดียว ไม่เขียน
  // JSON ก้อนเดียว ~2 KB ไม่มีข้อมูลผู้ใช้ ไม่มี login (§28.2)
  //
  // ต้องเป็น namespace เดียวกับที่ workers/lottery-cron/ ใช้เขียน ไม่ใช่คนละอัน
  "kv_namespaces": [
    { "binding": "LOTTERY", "id": "7db79be051f54457855d292027cd5cb3" }
  ],

  "vars": {
    // kill switch — ต้องเป็น "on" เท่านั้นจึงจะเปิด /api/lottery/latest
    // ตั้งเป็นค่าอื่นเมื่อใดก็ตามที่ endpoint ของ GLO มีปัญหา แล้วเว็บจะกลับไปใช้ static ล้วนทันที
    "LOTTERY_AUTO": "on"
  },

}
